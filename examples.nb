Cell["\<\
Make sure to use rational numbers as input: The algorithm needs the \
coefficients in sufficiently high precision\
\>", "Text",
 CellChangeTimes->{{4.0016609730787582`*^9, 
  4.001660997548615*^9}},ExpressionUUID->"778b742c-21cf-47d6-a49e-\
984fcdd9987a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"resParamSweep", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"AdaptiveDeficiencyIndices", "[", 
      RowBox[{"Hparam", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c1", "->", 
          RowBox[{"n1", "/", "16"}]}], ",", 
         RowBox[{"c2", "->", 
          RowBox[{"n2", "/", "16"}]}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n1", ",", 
       RowBox[{"-", "64"}], ",", "64"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n2", ",", 
       RowBox[{"-", "96"}], ",", "96"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{4.001660966393004*^9},
 CellLabel->"In[61]:=",ExpressionUUID->"18f4413b-eafc-45f6-ac87-3863b16c3684"],

Cell[BoxData[
 RowBox[{
  RowBox[{"resData", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"#", ",", "\"\<state\>\""}], "]"}], "!=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ",", 
        RowBox[{"-", "2"}], ",", "\[IndentingNewLine]", 
        RowBox[{"!", 
         RowBox[{"Equal", "[", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Lookup", "[", 
            RowBox[{"#", ",", "\"\<n\>\""}], "]"}]}], "]"}]}], ",", 
        RowBox[{"-", "1"}], ",", "\[IndentingNewLine]", "True", ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "\"\<n\>\""}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", " ", "]"}], " ", "&"}], " ", ",", " ", 
     "resParamSweep", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"7ac5c994-f22e-4db4-a3d1-177e915b76d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"resColorRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "->", "Red"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "->", "Orange"}], ",", 
     RowBox[{"0", "->", "LightBlue"}], ",", 
     RowBox[{"2", "->", "Blue"}], ",", 
     RowBox[{"4", "->", "DarkBlue"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resColorFunc", "=", 
   RowBox[{
    RowBox[{"Blend", "[", 
     RowBox[{
      RowBox[{"List", "@@@", "resColorRules"}], ",", "#"}], "]"}], "&"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"3480aad7-afeb-4050-9966-e28be749020d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sweepPlot", " ", "=", " ", 
  RowBox[{"ListContourPlot", "[", 
   RowBox[{"resData", ",", 
    RowBox[{"ColorFunction", "->", "resColorFunc"}], ",", 
    RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
    RowBox[{"Contours", "->", "3"}], ",", 
    RowBox[{"ContourStyle", "->", "None"}], ",", 
    RowBox[{"InterpolationOrder", "->", "Default"}], ",", 
    RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"DataRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["c", "2"], ",", 
       SubscriptBox["c", "1"]}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"SwatchLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"resColorFunc", "[", "0", "]"}], ",", 
         RowBox[{"resColorFunc", "[", "0.5", "]"}], ",", 
         RowBox[{"resColorFunc", "[", "1", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2", ",", "4"}], "}"}], ",", 
       RowBox[{
       "LegendLabel", 
        "->", "\"\< \!\(\*SubscriptBox[\(n\), \(\[PlusMinus]\)]\)\>\""}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"dc065307-ca6f-4ab3-86b0-f5b06bc16ac6"],

